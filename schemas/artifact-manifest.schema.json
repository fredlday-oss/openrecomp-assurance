{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrecomp.org/schemas/assurance/artifact-manifest-0.1.schema.json",
  "title": "OpenRecomp Assurance Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source", "translator", "artifacts"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/artifact"},
    "translator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 7},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
