{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrecomp.org/schemas/assurance/observation-0.1.schema.json",
  "title": "OpenRecomp Assurance Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "fixture_id", "observables"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "observables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
    }
  }
}
